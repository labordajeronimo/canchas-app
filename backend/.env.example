# Puerto del servidor (Render lo setea solo)
PORT=3000

# MongoDB Atlas (sin la contraseña real en este archivo)
MONGODB_URI=mongodb+srv://<usuario>:<password>@<cluster>.mongodb.net/canchas?retryWrites=true&w=majority

# DNS para resolver mongodb+srv (opcional). Por defecto 8.8.8.8,1.1.1.1; "system" usa el DNS del sistema
# DNS_SERVERS=

# Better Auth
# Generar con: npx @better-auth/cli secret   (o: openssl rand -base64 32)
BETTER_AUTH_SECRET=
# URL PÚBLICA por la que entra el navegador (el FRONTEND, porque /api se reescribe al backend)
# Local: http://localhost:5173   |   Producción: https://<tu-frontend>.onrender.com
BETTER_AUTH_URL=http://localhost:5173

# Origen del frontend (CORS + trustedOrigins)
FRONTEND_URL=http://localhost:5173

# GitHub OAuth App (callback: <BETTER_AUTH_URL>/api/auth/callback/github)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Google OAuth (opcional; si quedan vacías el login con Google se desactiva)
# Redirect URI: <BETTER_AUTH_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Usuarios de prueba que crea `npm run seed`
SEED_ADMIN_EMAIL=admin@canchas.com
SEED_ADMIN_PASSWORD=
SEED_USER_EMAIL=user@canchas.com
SEED_USER_PASSWORD=
